VITE_SUPABASE_URL=https://btuujsptmilidcywnmfw.supabase.co
# Use any one of these key names (all are supported by src/integrations/supabase/client.ts)
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare Turnstile
# Frontend key (safe for browser)
VITE_TURNSTILE_SITE_KEY=
# Server key (keep secret; use only in backend verification)
TURNSTILE_SECRET_KEY=

# Marketing / app domain split (see src/lib/domains.ts).
# Leave VITE_APP_ORIGIN unset to serve every route from one host (today's behaviour).
# Set it only after app.snippr.in is attached in Vercel, resolves in DNS, and is
# allowed in Supabase Auth redirect URLs:
# VITE_APP_ORIGIN=https://app.snippr.in
# VITE_MARKETING_ORIGIN=https://www.snippr.in

# Salon discovery map tiles (CARTO basemaps; see src/lib/mapConfig.ts).
# Browser-visible by design (VITE_), so restrict each key to its domains in CARTO.
# Without the key for the current mode, /salons shows a "map unavailable" notice
# and the list still works. There is no fallback from one key to the other.
# Production builds only — restricted to app.snippr.in:
VITE_CARTO_API_KEY=
# `npm run dev` only — allow your local origins (e.g. http://localhost:5173,
# http://127.0.0.1:5174). Restart the dev server after changing it.
VITE_CARTO_DEV_API_KEY=
